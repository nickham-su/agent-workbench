# 本地源码开发环境变量模板（复制为 .env.local）
#
# 适用场景：
# - 你在仓库源码目录下运行：npm run dev / npm run dev:api / npm run dev:web
#
# 重要说明：
# - 后端（apps/api）启动时会读取仓库根目录的 .env.local（仅 AWB_* 前缀）。
# - Docker Compose 不会读取 .env.local；容器部署请使用 .env.example / .env.docker.example。

# 基础服务配置
# - AWB_DATA_DIR：数据目录（会保存 DB、密钥、工作区等）
AWB_DATA_DIR=.data
# - AWB_HOST / AWB_PORT：API 服务监听地址与端口
AWB_HOST=127.0.0.1
AWB_PORT=4310
# - AWB_FILE_MAX_BYTES：文件读取/对比最大字节数
AWB_FILE_MAX_BYTES=1048576

# 可选:显式指定 /api/health 的 version
AWB_APP_VERSION=

# 预留:终端会话全局上限(当前未实现)
AWB_MAX_TERMINALS=

# 仅前端开发期（Vite dev server）使用（dev-only）
# - AWB_DEV_WEB_PORT：前端 dev server 监听端口（例如 5173/5174）
# - AWB_DEV_API_ORIGIN：前端 dev proxy 的后端目标（需要代理到远端时再设置）
AWB_DEV_WEB_PORT=
AWB_DEV_API_ORIGIN=

# 单端口交付（Fastify 托管 Web 静态资源 + SPA history fallback）
# - 本地开发通常保持 0，前端由 Vite 提供；Docker 部署建议用 1。
AWB_SERVE_WEB=0
# 生产环境可将 apps/web/dist 打包进镜像后，设置为对应目录
AWB_WEB_DIST_DIR=apps/web/dist

# Credential 主密钥（可选）
# - 为空时会在首次启动时自动生成并落盘到 AWB_DATA_DIR/keys/credential-master-key.json
AWB_CREDENTIAL_MASTER_KEY=

# 访问鉴权（可选）
# - 设置 AWB_AUTH_TOKEN 后启用鉴权：需要先在首页输入 token 登录，获取会话 Cookie
# - 未设置 AWB_AUTH_TOKEN 则保持无鉴权（适合仅本机使用）
AWB_AUTH_TOKEN=
# Cookie Secure 属性开关（仅 HTTPS 场景建议开启；本地 http 开发保持 0）
AWB_AUTH_COOKIE_SECURE=0

# Agent worker（独立进程，开发期默认启用）
# - 设为 0 可回退到 API 进程内 runtime（调试/排障时可用）
AWB_AGENT_WORKER_ENABLED=1
# - AWB_AGENT_WORKER_HOST / AWB_AGENT_WORKER_PORT：worker 监听地址与端口（通常无需改）
AWB_AGENT_WORKER_HOST=127.0.0.1
AWB_AGENT_WORKER_PORT=4312
# - AWB_AGENT_WORKER_SOCKET：worker 使用的 unix socket 路径
#   默认优先使用 unix socket(为空时自动落到 AWB_DATA_DIR/agent-worker.sock)
AWB_AGENT_WORKER_SOCKET=
# - AWB_AGENT_WORKER_CONCURRENCY：worker 并发处理任务数（session 仍会串行）
AWB_AGENT_WORKER_CONCURRENCY=3

# Agent 运行/排障（开发者常用）
# - 调试开关: 设为 1 时,每个 context item 会落盘到 <workspace>/.debug/agent_context_item_logs/
AWB_AGENT_DEBUG_DUMP=0
# - step-loop 最大轮数,<=0 表示不限制
AWB_AGENT_LOOP_MAX_STEPS=128
# - 连续重复工具调用阈值,<=0 表示不限制
AWB_AGENT_LOOP_REPEAT_TOOL_CALL_THRESHOLD=20
# - Agent 启动恢复策略（开发期默认 fail）
AWB_AGENT_STARTUP_RECOVERY_MODE=fail

# 高级/一般无需改：
# - 为空时 API 启动会自动生成随机 token，并传给 worker 子进程
AWB_AGENT_INTERNAL_TOKEN=
# - worker 回调 API 的地址（通常保持为空自动推导）
AWB_AGENT_API_ORIGIN=
