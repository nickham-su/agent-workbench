{
  "name": "@agent-workbench/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:all",
    "test:all": "node scripts/verify-test-gate.mjs && npm run test:unit && npm run test:integration && npm run test:integration:worker",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:integration:worker": "node scripts/run-tests.mjs worker",
    "test:session-model": "npm run test:unit",
    "test:session-title": "tsx --test src/modules/agent/session/session-title.test.ts src/modules/agent/session/session-title.store.test.ts src/modules/agent/integration/agent-session-title.integration.test.ts"
  },
  "dependencies": {
    "@agent-workbench/shared": "*",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@fastify/websocket": "^11.2.0",
    "@sinclair/typebox": "^0.34.47",
    "archiver": "^6.0.2",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.0",
    "node-pty": "^1.1.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
