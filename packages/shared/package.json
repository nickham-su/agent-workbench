{
  "name": "@agent-workbench/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llm-single-call": {
      "types": "./dist/llm/single-call.d.ts",
      "default": "./dist/llm/single-call.js"
    },
    "./llm-ai-sdk-call-settings": {
      "types": "./dist/llm/ai-sdk-call-settings.d.ts",
      "default": "./dist/llm/ai-sdk-call-settings.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "default": "./dist/prompts.js"
    },
    "./internal-contracts/endpoints": {
      "types": "./dist/internal-contracts/endpoints.d.ts",
      "default": "./dist/internal-contracts/endpoints.js"
    },
    "./internal-contracts/errors": {
      "types": "./dist/internal-contracts/errors.d.ts",
      "default": "./dist/internal-contracts/errors.js"
    },
    "./internal-contracts/agent-worker": {
      "types": "./dist/internal-contracts/agent-worker.d.ts",
      "default": "./dist/internal-contracts/agent-worker.js"
    },
    "./internal-contracts/agent-api": {
      "types": "./dist/internal-contracts/agent-api.d.ts",
      "default": "./dist/internal-contracts/agent-api.js"
    },
    "./internal-contracts/agent-api-session": {
      "types": "./dist/internal-contracts/agent-api-session.d.ts",
      "default": "./dist/internal-contracts/agent-api-session.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:clean-build": "node scripts/verify-clean-build.mjs",
    "test": "npm run test:clean-build && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.102",
    "@ai-sdk/openai": "^2.0.127",
    "@ai-sdk/openai-compatible": "^1.0.54",
    "@sinclair/typebox": "^0.34.47",
    "ai": "^5.0.260"
  }
}
