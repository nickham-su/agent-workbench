{
  "name": "@agent-workbench/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llm-single-call": {
      "types": "./dist/llm/single-call.d.ts",
      "default": "./dist/llm/single-call.js"
    },
    "./prompts": {
      "types": "./dist/prompts.d.ts",
      "default": "./dist/prompts.js"
    },
    "./internal-contracts/endpoints": {
      "types": "./dist/internal-contracts/endpoints.d.ts",
      "default": "./dist/internal-contracts/endpoints.js"
    },
    "./internal-contracts/errors": {
      "types": "./dist/internal-contracts/errors.d.ts",
      "default": "./dist/internal-contracts/errors.js"
    },
    "./internal-contracts/agent-worker": {
      "types": "./dist/internal-contracts/agent-worker.d.ts",
      "default": "./dist/internal-contracts/agent-worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.67",
    "@ai-sdk/openai": "^2.0.23",
    "@ai-sdk/openai-compatible": "^1.0.39",
    "@sinclair/typebox": "^0.34.47",
    "ai": "^5.0.22"
  }
}
