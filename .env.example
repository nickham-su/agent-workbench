## Docker Compose 配置模板（复制为 .env，推荐）
#
# 适用场景：
# - Docker 部署（推荐方式）：docker compose up -d --build
#
# 重要说明：
# - Docker Compose 的 .env 文件主要用于“变量替换”。只有在 docker-compose.yml 中显式写入
#   services.<name>.environment（或 env_file） 的变量，才会进入容器进程的环境变量。
# - 本地源码开发（npm run dev）请使用 .env.dev.example 复制为 .env.local。

# 端口发布绑定地址（公网部署请谨慎）
# - 仅本机访问：127.0.0.1
# - 允许局域网/公网：0.0.0.0（建议配合防火墙 + 鉴权 + HTTPS 反代）
#
# 安全建议：本模板默认仅绑定 localhost；如需局域网/公网访问请改为 0.0.0.0，并确保启用鉴权/反代与防火墙。
AWB_PUBLISH_HOST=127.0.0.1

# Agent Workbench (Web UI + API) 端口
AWB_PORT=4310

# Workspace 静态预览（可选；启用后使用独立 preview origin）
# - 默认关闭。启用后，AWB_PREVIEW_ORIGIN 必填且必须是纯 http(s) origin，不能带路径、query 或 fragment。
# - preview origin 必须与主站 origin 不同；不得使用 path-style URL，例如 https://awb.example.com/preview。
# - AWB_PREVIEW_HOST 是容器内监听地址；AWB_PREVIEW_PUBLISH_HOST 只控制 Compose 宿主机端口绑定。
# - 下面是本机 Compose 的可用示例：
#     AWB_PREVIEW_ENABLED=true
#     AWB_PREVIEW_ORIGIN=http://127.0.0.1:4311
# - 生产 HTTPS 请使用独立域名，例如 https://preview.example.com，并在反向代理中单独转发该域名。
AWB_PREVIEW_ENABLED=false
AWB_PREVIEW_ORIGIN=
AWB_PREVIEW_HOST=0.0.0.0
AWB_PREVIEW_PORT=4311
# session 的绝对 TTL（秒），范围 60..86400；bootstrap code 的 TTL 固定为 60 秒，不能配置。
AWB_PREVIEW_SESSION_TTL_SECONDS=3600
# 仅 Docker Compose 使用：preview 端口在宿主机上的绑定地址。生产反代建议保持 127.0.0.1。
AWB_PREVIEW_PUBLISH_HOST=127.0.0.1
# 安全边界：preview 必须使用独立域名/独立 origin，不能与其他应用复用；响应始终 no-store。

# 文件读取/对比最大字节数（可选）
AWB_FILE_MAX_BYTES=1048576

# 可选:显式指定 /api/health 的 version
AWB_APP_VERSION=

# 工作区端口段（用于发布工作区内启动的服务）
AWB_WORKSPACE_PORT_RANGE=30000-30100

# 容器内监听地址
AWB_HOST=0.0.0.0

# 数据目录（建议保持 /data，写入到 volume）
AWB_DATA_DIR=/data

# 单端口交付：后端托管 Web 静态资源 + SPA history fallback
AWB_SERVE_WEB=1
# 前端静态资源目录（需与镜像内构建产物路径一致）
AWB_WEB_DIST_DIR=/app/apps/web/dist

# Credential 主密钥（可选，迁移场景建议显式设置）
# - 留空时首次启动会自动生成并写入 AWB_DATA_DIR/keys/credential-master-key.json
# AWB_CREDENTIAL_MASTER_KEY=

# 访问鉴权（可选）
# - 设置 AWB_AUTH_TOKEN 后启用鉴权：访问 / 时需要先输入 token 登录（会话 Cookie）
# - 未设置 AWB_AUTH_TOKEN 则保持无鉴权（仅建议在可信环境使用）
AWB_AUTH_TOKEN=
# HTTPS 场景建议设为 1（为会话 Cookie 添加 Secure）；本地 HTTP 开发保持 0
AWB_AUTH_COOKIE_SECURE=0
# preview origin 为 HTTPS 时，preview session Cookie 会自动带 Secure；不要尝试在此处覆盖。

# Agent worker / 运行参数（Docker 下常用可调项）
# - AWB_AGENT_WORKER_ENABLED=0 可回退到 API 进程内 runtime（一般仅用于排障）
AWB_AGENT_WORKER_ENABLED=1
# - AWB_AGENT_WORKER_CONCURRENCY：worker 并发处理任务数
#   注意：同一个 sessionId 的 run 仍会串行；提高并发需要同时有多个不同 session 在跑。
AWB_AGENT_WORKER_CONCURRENCY=5
# - step-loop 最大轮数,<=0 表示不限制
AWB_AGENT_LOOP_MAX_STEPS=200
# - 连续重复工具调用阈值,<=0 表示不限制
AWB_AGENT_LOOP_REPEAT_TOOL_CALL_THRESHOLD=20
# - Worker → API 控制面 RPC 单次 attempt timeout（毫秒）；默认值权威来源为 Worker 的 loadWorkerEnv()。
#   仅影响内部控制面调用，不改变模型/Provider timeout。
AWB_AGENT_INTERNAL_RPC_TIMEOUT_MS=15000
# - completeRun 控制面 RPC 单次 attempt timeout（毫秒）；默认值权威来源为 Worker 的 loadWorkerEnv()。
#   仅影响内部控制面调用，不改变模型/Provider timeout。
AWB_AGENT_COMPLETE_RUN_TIMEOUT_MS=5000
# - 调试开关: 设为 1 时,每个 context item 会落盘到 <workspace>/.debug/agent_context_item_logs/
AWB_AGENT_DEBUG_DUMP=0
# - 工具错误诊断 artifact：仅设为 1 时开启，默认关闭；将非取消类工具失败的完整参数、结果和错误写入 <workspace>/.awb/agent/tool-errors/，供排障分析
AWB_TOOL_ERROR_STORE_ENABLED=0

# Agent 启动恢复策略（默认 fail）
# - fail: 启动时将 DB 中处于 running 的 run 尽可能标记为 failed，并将会话 run-state 重置为 idle。
# - recover: 启动时恢复这些 run（enqueue 到 worker 继续推进）。
AWB_AGENT_STARTUP_RECOVERY_MODE=fail

# Agent 插件宿主/插件服务（默认开启）
# - AWB_AGENT_PLUGIN_HOST_ENABLED：是否启用插件宿主进程
AWB_AGENT_PLUGIN_HOST_ENABLED=1
# - AWB_AGENT_PLUGIN_SERVICES_ENABLED：是否启用插件服务注册/调用
AWB_AGENT_PLUGIN_SERVICES_ENABLED=1
# - AWB_AGENT_PLUGIN_HOST_DEV：插件宿主开发模式（1=使用源码启动）
AWB_AGENT_PLUGIN_HOST_DEV=0
